# Comma-separated per-device API tokens. Remove one to revoke that device.
# Generate one with: openssl rand -hex 24
BOOKMARKS_TOKENS=change-me
# Port published on the host (bound to 127.0.0.1 in docker-compose.yml).
BOOKMARKS_PORT=8787
# Time zone for {{date}} in notes, e.g. America/New_York (UTC when unset).
# TZ=

# Optional tuning (defaults shown).
# BOOKMARKS_CONCURRENCY=1
# BOOKMARKS_CAPTURE_TIMEOUT_MS=45000
# BOOKMARKS_WAIT_CAP_MS=60000        # longest POST /capture?wait=1 is held
# BOOKMARKS_RETENTION_DAYS=7         # delivered captures are pruned after this
# BOOKMARKS_SCREENSHOT_FORMAT=jpeg   # or png (3-5x larger)
# BOOKMARKS_MAX_HEIGHT=20000
# BOOKMARKS_USER_AGENT=              # defaults to desktop Chrome
# BOOKMARKS_ALLOW_PRIVATE_NETWORKS=0 # 1 allows capturing LAN/localhost URLs
